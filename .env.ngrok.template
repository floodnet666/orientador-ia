# Template (.env) para Exposição com ngrok
# 1. Rode 'ngrok http 3000' -> Pegue a URL (ex: https://dominio-fe.ngrok.app)
# 2. Rode 'ngrok http 8000' -> Pegue a URL (ex: https://dominio-be.ngrok.app)

# URLs do Frontend e Backend para o Browser
NEXT_PUBLIC_API_URL=https://dominio-be.ngrok.app
NEXT_PUBLIC_WS_URL=wss://dominio-be.ngrok.app

# Origem que o Backend deve permitir (URL do Frontend)
ALLOWED_ORIGINS=https://dominio-fe.ngrok.app,http://localhost:3000
