# Template (.env) para Exposição com ngrok
# 1. Configure o ngrok.yml e rode: ngrok start --all --config ngrok.yml
# 2. Pegue as duas URLs geradas no terminal (frontend e backend)

# URLs do Frontend e Backend para o Browser
# Exemplo (substitua pelos links reais que o ngrok exibir):
# NEXT_PUBLIC_API_URL=https://link-backend.ngrok-free.app
# NEXT_PUBLIC_WS_URL=wss://link-backend.ngrok-free.app
# ALLOWED_ORIGINS=https://link-frontend.ngrok-free.app,http://localhost:3000
