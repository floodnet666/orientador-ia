[project]
name = "backend"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "alembic>=1.14.1",
    "asyncpg>=0.30.0",
    "fastapi>=0.115.8",
    "email-validator>=2.2.0",
    "greenlet>=3.1.1",
    "passlib[bcrypt]>=1.7.4",
    "bcrypt<4.0.0",
    "pydantic-settings>=2.7.1",
    "pydantic>=2.10.6",
    "python-jose[cryptography]>=3.3.0",
    "python-multipart>=0.0.20",
    "qdrant-client>=1.13.2",
    "redis>=5.2.1",
    "sqlalchemy>=2.0.38",
    "uvicorn>=0.34.0",
]

[dependency-groups]
dev = [
    "httpx>=0.28.1",
    "pytest>=9.0.2",
    "pytest-asyncio>=1.3.0",
    "ruff>=0.15.4",
]

[[tool.uv.index]]
name = "pypi"
url = "https://pypi.org/simple"
default = true
